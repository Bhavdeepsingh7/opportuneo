# LLM Provider (required for AI generation)
# Options: 'groq' or 'gemini'
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-api03-...

# Supabase (required for auth)
SUPABASE_URL= https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY= eyJhbGciOi

# Razorpay Test Mode keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Google OAuth (required for Gmail sending)
# Create at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID is used for Supabase Auth
GOOGLE_CLIENT_ID=your-supabase-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-supabase-secret

# GOOGLE_CLIENT_ID_WEB is used for Gmail OAuth Connection
GOOGLE_CLIENT_ID_WEB=your-gmail-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_WEB=GOCSPX-gmail-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# App
FRONTEND_URL=https://your-frontend.vercel.app
SECRET_KEY=generate-a-random-32-char-string-here

# RabbitMQ (required for asynchronous campaign sending)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=campaign_queue
RABBITMQ_DEAD_QUEUE=dead_letter_queue
